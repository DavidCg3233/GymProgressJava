# Copia este archivo como ".env" en esta misma carpeta y llena los valores.
# ".env" está en .gitignore: NUNCA se sube al repositorio (RNF-SEG-03).

# Clave secreta de Django. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
GP_SECRET_KEY=

# 1 solo en tu equipo, para ver los errores con detalle. En el servidor: 0.
GP_DEBUG=1

GP_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Inventa una contraseña larga; no reutilices ninguna tuya.
GP_DB_NAME=gymprogress
GP_DB_USER=gymprogress
GP_DB_PASSWORD=
