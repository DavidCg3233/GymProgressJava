# Copia este archivo como ".env" y llena los valores.
# ".env" está en .gitignore: NUNCA se sube al repositorio (RNF-SEG-03).

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
GP_SECRET_KEY=

# Solo en tu equipo. En el servidor debe quedar vacía o en 0.
GP_DEBUG=0

# Nombres desde los que se atiende, separados por comas.
GP_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
GP_DB_NAME=gymprogress
GP_DB_USER=gymprogress
GP_DB_PASSWORD=
GP_DB_HOST=localhost
GP_DB_PORT=5432
